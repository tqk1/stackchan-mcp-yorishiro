# stackchan-mcp gateway environment variables
# Copy this file to `.env` and fill in your values.

# --- ESP32 authentication ---
# Token sent by the ESP32 as `Authorization: Bearer <token>`.
# Set the same value in the firmware's WiFi config UI (token field).
STACKCHAN_TOKEN=your-secret-token-here

# Legacy alias (still supported, prefer STACKCHAN_TOKEN above).
BEARER_TOKEN=

# --- WebSocket server (ESP32 -> gateway) ---
HOST=0.0.0.0
WS_PORT=8765

# --- HTTP capture server (ESP32 -> gateway, photo upload) ---
CAPTURE_PORT=8766

# Full public capture URL sent to the ESP32.
# Use this for remote tunnel setups such as Tailscale Funnel.
# Example: https://stackchan.example.ts.net:8443/capture
VISION_URL=

# Optional separate bearer token for HTTP photo uploads to VISION_URL.
# If empty, STACKCHAN_TOKEN is reused.
VISION_TOKEN=

# LAN IP of THIS machine, as seen from the ESP32.
# The gateway tells the ESP32 to POST captured photos to this address.
# Required if you want take_photo to work and VISION_URL is not set.
# Example: something like 192.168.x.y on a typical home network
# (run `ifconfig` / `ip addr` to find your host's LAN IP).
VISION_HOST=

# ===========================================================
# Tap-to-talk voice loop (yorishiro fork)
#
# Everything below is OFF by default. The single switch that
# turns the loop on is STACKCHAN_AUDIO_HOOK_URL: until it is
# set, the firmware still records when you tap the screen but
# the gateway discards the audio, so nothing appears to happen.
# See README "Optional: tap-to-talk voice loop".
# ===========================================================

# --- The switch ---
# Where the gateway POSTs a finished device-side recording.
# Point it at this gateway's own /voice_turn endpoint to close
# the loop in-process (STT -> agent -> TTS -> device speaker).
# Use the same port as CAPTURE_PORT above.
STACKCHAN_AUDIO_HOOK_URL=http://127.0.0.1:8766/voice_turn

# Optional shared bearer token for /voice_turn. When set, the
# endpoint rejects requests without it. Both the sender and the
# receiver are this gateway, so one value is enough.
STACKCHAN_AUDIO_HOOK_TOKEN=

# --- The brain (OpenAI-compatible chat endpoint) ---
# Base URL of the Hermes Agent API server adapter. Hermes only
# opens this port when it is started with API_SERVER_ENABLED=true
# — running Hermes in interactive chat mode is not enough, and
# the gateway then fails the turn with a connection-refused 502.
HERMES_API_URL=http://127.0.0.1:8642

# Bearer token for the above. Optional, but WITHOUT it every turn
# is stateless: Hermes gates conversation memory on API-key auth,
# so the robot answers each sentence with no idea what you just
# said. Set Hermes' API_SERVER_KEY to the same value.
HERMES_API_KEY=

# Namespace for the rotating per-conversation session id.
HERMES_SESSION_ID=stackchan-voice

# Overrides the built-in system prompt that keeps spoken replies
# short. The default is written in Japanese — set your own here
# to have the robot answer in another language.
#
# "One to three sentences" is not a style preference: the whole
# reply is synthesised before the robot says a word, so every extra
# sentence is extra silence first. A model given this instruction in
# a language it is not answering in tends to ignore it.
#
# HERMES_VOICE_SYSTEM_PROMPT=You are a small desktop robot speaking out loud. The user's words reach you through speech recognition, so read past small errors. Answer in one to three short spoken sentences. No lists, no markup, no emoji.
HERMES_VOICE_SYSTEM_PROMPT=

# Overrides the tool-routing paragraph appended to the prompt above
# on every turn. Also Japanese by default, so overriding only the
# system prompt still tends to pull replies back into Japanese.
#
# The last sentence is worth keeping in any translation: some models
# will otherwise report an action they never took ("saved your
# preference") without ever calling a tool.
#
# HERMES_VOICE_TOOLS_PROMPT=Anything you have to look up — weather, news, facts — you must fetch with the web_search MCP tool. Save notes with write_note (append=true to add), read them back with list_notes / read_note, and control appliances with the switchbot_* tools. Do not use the terminal or any other route. Never say you have done something unless you called the tool that does it.
HERMES_VOICE_TOOLS_PROMPT=

# --- Speech recognition (requires a [stt-*] extra) ---
# Language of the speaker, as an ISO-639-1 code. The tap-to-talk
# path never passes a language argument, so this is the only way
# to change it for the voice loop.
STACKCHAN_STT_LANGUAGE=ja
STACKCHAN_FASTER_WHISPER_MODEL=base

# Vocabulary hint, free text. A small model mishears exactly the
# words it has no prior for — the robot's name, the names of the
# people talking to it. List them here and recognition is biased
# towards them. Unset by default; the startup log states which.
# STACKCHAN_FASTER_WHISPER_HOTWORDS=Saki, Dale

# Beam width. 1 (the default here) is greedy and fastest; Whisper's
# own default is 5, which costs some latency and buys accuracy on
# that same class of word.
# STACKCHAN_FASTER_WHISPER_BEAM_SIZE=1

# --- Speech synthesis (requires the [tts] or [tts-piper] extra) ---
# VOICEVOX (Japanese) — the default engine.
STACKCHAN_VOICEVOX_URL=http://127.0.0.1:50021

# Piper (English and others). Setting the model path selects Piper.
#
# Prefer a "low" voice. Those are natively 16 kHz — the rate the
# device plays at — so the samples ship untouched. A "medium" voice
# is 22.05 kHz and gets linearly resampled on the way out, which is
# both slower to synthesise and audibly rougher on s/sh sounds.
# STACKCHAN_PIPER_MODEL=voices/en_US-lessac-low.onnx

# --- Web search (requires the [search] extra) ---
# Region for the keyless DuckDuckGo fallback. Defaults to jp-jp,
# which is this fork's own deployment; set your own so that asking
# for local weather or news searches the right country.
# STACKCHAN_SEARCH_REGION=ca-en
